# Copy this file to server/.env and fill in the values.
# Only JWT_SECRET is required; everything else has a working default for a local install.

# --- Required -------------------------------------------------------------

# Secret used to sign login tokens. Use a long random string and keep it private.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server and database -----------------------------------------------------

# Port the app listens on (website and API).
PORT=3000

# MongoDB connection string and database name.
# Docker Compose overrides MONGODB_URI to use its bundled MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=cck_hrpms

# Set to production when deploying.
NODE_ENV=development

# Public address of the website, used for links in emails (password reset, survey invitations).
# Example: https://hr.example.com   (defaults to http://localhost:3001 in development)
APP_URL=

# Set to 1 when running behind one reverse proxy (Nginx, Caddy) so login limits apply per visitor,
# not to everyone at once. Leave empty when the app is reached directly.
TRUST_PROXY=

# Allowed origins for the separate client dev server (comma-separated).
# Not needed in production, where the server also serves the website.
CORS_ORIGIN=http://localhost:3001

# --- Email (optional) --------------------------------------------------------
# Without email settings the app still works, but password reset links,
# appraisal PDFs and survey invitations will not be emailed.

# Option A: any SMTP provider (used when SMTP_HOST is set). Port 465 with TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Option B: a Gmail account with an app password (used when SMTP_HOST is empty).
# Create an app password at https://myaccount.google.com/apppasswords
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Sender shown on emails, e.g. "CCK HR <hr@example.com>". Defaults to the account above.
EMAIL_FROM=

# Name used in email subjects and the sender name.
APP_NAME=CCK Group HR Performance Measure System

# --- PDF generation (optional) ----------------------------------------------
# Puppeteer downloads its own Chromium on npm install. Set this only to use a
# system Chrome/Chromium instead (the Docker image sets it automatically, so leave it commented there).
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
