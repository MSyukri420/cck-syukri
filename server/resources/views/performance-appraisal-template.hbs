<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, height=device-height, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="{{stylesheet}}">
    <title>Performance Appraisal</title>
</head>
<body>
<div class="flex flex-col h-screen w-screen gap-4 p-12">
    <div class="flex flex-row justify-center w-full h-12">
        <img src="{{logoUrl}}" alt="logo" class="w-auto h-full">
    </div>
    <div class="flex flex-col items-center w-full mb-4">
        <h1 class="font-medium uppercase text-2xl">CCK Group of Companies</h1>
        <p class="font-medium">Performance Appraisal</p>
    </div>
    <div class="flex flex-col gap-2">
        <h2 class="font-medium uppercase text-sm">1. Employee's Particular</h2>
        <div class="flex flex-row gap-12 uppercase text-sm">
            <div class="flex flex-col gap-1">
                <div class="flex flex-row gap-2">
                    <p>Name</p>
                    <p>:</p>
                    <p>{{employeeName}}</p>
                </div>
                <div class="flex flex-row gap-2">
                    <p>Review Period</p>
                    <p>:</p>
                    <p>{{reviewPeriod}}</p>
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <div class="flex flex-row gap-2">
                    <p>Department</p>
                    <p>:</p>
                    <p>{{departmentName}}</p>
                </div>
                <div class="flex flex-row gap-2">
                    <p>Designation</p>
                    <p>:</p>
                    <p>{{designationName}}</p>
                </div>
                <div class="flex flex-row gap-2">
                    <p>Job Grade</p>
                    <p>:</p>
                    <p>G{{jobGradeName}}</p>
                </div>
            </div>
        </div>
    </div>
    <div class="flex flex-row gap-4">
        <div class="flex flex-row gap-4 border-2 font-medium p-2 text-sm">
            <div class="flex flex-col gap-1">
                <p>Grading:</p>
                <p>Score %:</p>
            </div>
            <div class="flex flex-col gap-1 items-center">
                <p>A</p>
                <p>(85-100)</p>
            </div>
            <div class="flex flex-col gap-1 items-center">
                <p>B</p>
                <p>(70-84)</p>
            </div>
            <div class="flex flex-col gap-1 items-center">
                <p>C</p>
                <p>(50-69)</p>
            </div>
            <div class="flex flex-col gap-1 items-center">
                <p>D</p>
                <p>(30-49)</p>
            </div>
            <div class="flex flex-col gap-1 items-center">
                <p>E</p>
                <p>(0-29)</p>
            </div>
        </div>
        <div class="flex flex-row gap-6 font-medium text-sm items-center">
            <div class="flex flex-col gap-2">
                <p>Total Point:</p>
                <p>Grade:</p>
            </div>
            <div class="flex flex-col">
                <p class="border-2 px-4 py-1">{{stats.totalScore}}</p>
                <p class="border-2 px-4 py-1">{{stats.grade}}</p>
            </div>
        </div>
    </div>
    <div class="flex flex-col gap-4">
        <h2 class="font-medium uppercase text-sm">2. Appraiser's Comments</h2>
        <p class="text-sm">{{#if appraiserComment}}{{appraiserComment}}{{else}}Appraiser has not commented on the performance appraisal.{{/if}}</p>
    </div>
    <div class="flex flex-col gap-4">
        <h2 class="font-medium uppercase text-sm">3. Employee's Comments</h2>
        <p class="text-sm">{{#if employeeComment}}{{employeeComment}}{{else}}Employee has not commented on the performance appraisal.{{/if}}</p>
    </div>
    <div class="flex flex-col gap-4">
        <h2 class="font-medium uppercase text-sm">4. Performance Appraisal</h2>
        <div class="flex flex-col gap-2 text-sm">
            <table class="w-full border-collapse text-xs">
                <thead>
                <tr>
                    <th class="border border-black p-1.5">Key Performance Area</th>
                    <th class="border border-black p-1.5">Marks</th>
                    <th class="border border-black p-1.5">Weight</th>
                    <th class="border border-black p-1.5">W. Mark</th>
                    <th class="border border-black p-1.5">%</th>
                    <th class="border border-black p-1.5">Score</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td colspan="6" class="py-4 font-bold text-base">Know How</td>
                </tr>
                {{#each stats.knowHow.attributes}}
                    <tr>
                        <td colspan="6" class="py-2 font-bold">{{this.attributeName}}</td>
                    </tr>
                    {{#each this.subAttributes}}
                        <tr>
                            <td class="border border-black p-1.5">{{this.name}}</td>
                            <td class="border border-black p-1.5 text-center">{{this.marksGiven}}</td>
                            <td class="border border-black p-1.5 text-center">{{this.weight}}%</td>
                            <td class="border border-black p-1.5 text-center">{{this.weightMark}}</td>
                        </tr>
                    {{/each}}
                {{/each}}
                <tr>
                    <td colspan="2" class="p-1.5 font-bold"></td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.knowHow.totalWeight}}%</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.knowHow.totalWeightedMarks}}</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.knowHow.percentageCarry}}%</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.knowHow.percentageScore}}</td>
                </tr>
                <tr>
                    <td colspan="6" class="py-4 font-bold text-base">Problem Solving</td>
                </tr>
                {{#each stats.problemSolving.attributes}}
                    <tr>
                        <td colspan="6" class="py-2 font-bold">{{this.attributeName}}</td>
                    </tr>
                    {{#each this.subAttributes}}
                        <tr>
                            <td class="border border-black p-1.5">{{this.name}}</td>
                            <td class="border border-black p-1.5 text-center">{{this.marksGiven}}</td>
                            <td class="border border-black p-1.5 text-center">{{this.weight}}%</td>
                            <td class="border border-black p-1.5 text-center">{{this.weightMark}}</td>
                        </tr>
                    {{/each}}
                {{/each}}
                <tr>
                    <td colspan="2" class="p-1.5 font-bold"></td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.problemSolving.totalWeight}}%</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.problemSolving.totalWeightedMarks}}</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.problemSolving.percentageCarry}}%</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.problemSolving.percentageScore}}</td>
                </tr>
                <tr>
                    <td colspan="6" class="py-4 font-bold text-base">Accountability</td>
                </tr>
                {{#each stats.accountability.attributes}}
                    <tr>
                        <td colspan="6" class="py-2 font-bold">{{this.attributeName}}</td>
                    </tr>
                    {{#each this.subAttributes}}
                        <tr>
                            <td class="border border-black p-1.5">{{this.name}}</td>
                            <td class="border border-black p-1.5 text-center">{{this.marksGiven}}</td>
                            <td class="border border-black p-1.5 text-center">{{this.weight}}%</td>
                            <td class="border border-black p-1.5 text-center">{{this.weightMark}}</td>
                        </tr>
                    {{/each}}
                {{/each}}
                <tr>
                    <td colspan="2" class="p-1.5 font-bold"></td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.accountability.totalWeight}}%</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.accountability.totalWeightedMarks}}</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.accountability.percentageCarry}}%</td>
                    <td class="border border-black p-1.5 text-center font-bold">{{stats.accountability.percentageScore}}</td>
                </tr>
                <tr>
                    <td colspan="6" class="p-2"></td>
                </tr>
                <tr>
                    <td colspan="4" class="border border-black p-1.5 font-black uppercase">Total</td>
                    <td class="border border-black p-1.5 font-black text-center">100%</td>
                    <td class="border border-black p-1.5 font-black text-center">{{stats.totalScore}}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="flex flex-col gap-2 items-center py-2 text-sm">
        <hr class="border-1 border-black w-full" />
        <p>This performance appraisal report is digitally generated.</p>
    </div>
</div>
</body>
</html>