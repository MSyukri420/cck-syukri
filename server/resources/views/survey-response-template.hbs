<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Survey Response</title>
    <link rel="stylesheet" href="{{stylesheet}}">
</head>
<body>
<div class="flex flex-col h-screen w-screen gap-4 p-12">
    <div class="flex flex-row justify-center w-full h-12">
        <img src="{{logoUrl}}" alt="logo" class="w-auto h-full">
    </div>
    <div class="flex flex-col items-center w-full mb-4">
        <h1 class="font-medium uppercase text-2xl">CCK Group of Companies</h1>
        <p class="font-medium">Employee Performance Survey</p>
    </div>
    <div class="flex flex-col gap-2 text-sm my-4">
        <h2 class="font-medium uppercase pt-4">1. Employee's Particular</h2>
        <div class="flex flex-row gap-2">
            <p>Name</p>
            <p>:</p>
            <p>{{employee.name}}</p>
        </div>
        <div class="flex flex-row gap-2">
            <p>Review Period</p>
            <p>:</p>
            <p>{{campaignStartDate}} to {{campaignEndDate}}</p>
        </div>
        <div class="flex flex-row gap-2">
            <p>Department</p>
            <p>:</p>
            <p>{{employee.department.departmentName}}</p>
        </div>
        <div class="flex flex-row gap-2">
            <p>Designation</p>
            <p>:</p>
            <p>{{employee.designation.name}}</p>
        </div>
        <div class="flex flex-row gap-2">
            <p>Job Grade</p>
            <p>:</p>
            <p>{{employee.jobGrade.jobGradeName}}</p>
        </div>
    </div>
    <div class="flex flex-col gap-4">
        <h2 class="font-medium uppercase text-sm">2. Survey Description</h2>
        <p class="text-sm">{{campaign.campaignDescription}}</p>
    </div>
    <div class="flex flex-col gap-4">
        <h2 class="font-medium uppercase">3. Survey Questions</h2>
        <div class="flex flex-col gap-2">
            {{#each surveyResponse}}
                <div class="mb-[30px] text-sm bg-white rounded-md shadow-md ring-1 ring-gray-200">
                    <!-- Card Body -->
                    <div class="p-[16px]">
                        <!-- Card Content -->
                        <div class="px-[12px] text-center">
                            <div class="flex justify-center gap-8">
                                <!-- Question Title -->
                                <div class="w-full flex items-center gap-4">
                                    <p class="font-medium">{{add @index 1}}</p>
                                    <p>{{this.question}}</p>
                                </div>
                            </div>
                            <!-- Question Type Selection -->
                            <div>
                                <!-- Question Type - Linear Scale -->
                                <div class="mt-8 flex flex-row-reverse justify-center items-end gap-12 text-black">
                                    <span>{{this.low}}</span>
                                    <div class="flex flex-col items-center gap-4">
                                        {{#if (eq this.rating 1)}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-280q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{else}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{/if}}
                                        <label for="question-{{@../index}}-rating-1">1</label>
                                    </div>
                                    <div class="flex flex-col items-center gap-4">
                                        {{#if (eq this.rating 2)}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-280q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{else}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{/if}}
                                        <label for="question-{{@../index}}-rating-2">2</label>
                                    </div>
                                    <div class="flex flex-col items-center gap-4">
                                        {{#if (eq this.rating 3)}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-280q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{else}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{/if}}
                                        <label for="question-{{@../index}}-rating-3">3</label>
                                    </div>
                                    <div class="flex flex-col items-center gap-4">
                                        {{#if (eq this.rating 4)}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-280q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{else}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{/if}}
                                        <label for="question-{{@../index}}-rating-4">4</label>
                                    </div>
                                    <div class="flex flex-col items-center gap-4">
                                        {{#if (eq this.rating 5)}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-280q83 0 141.5-58.5T680-480q0-83-58.5-141.5T480-680q-83 0-141.5 58.5T280-480q0 83 58.5 141.5T480-280Zm0 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{else}}
                                            <svg class="fill-black" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                        {{/if}}
                                        <label for="question-{{@../index}}-rating-5">5</label>
                                    </div>
                                    <span>{{this.high}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</div>
</body>
</html>